# Dedicated PostgreSQL. Do not point this at the original Chicago database.
DATABASE_URL=
DATABASE_SSL=false
NEXT_PUBLIC_SITE_URL=
# Owner account is created once. Minimum 12 characters; change through Settings later.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Random 32+ characters. Retain this key or encrypted provider settings become unreadable.
SETTINGS_ENCRYPTION_KEY=
CRON_SECRET=
# Optional business defaults. Prefer editing business configuration in the admin portal.
NEXT_PUBLIC_BUSINESS_PHONE=
BUSINESS_EMAIL=
GOOGLE_ANALYTICS_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v23.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
SMS_PROVIDER_ACCOUNT_ID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_FROM_NUMBER=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local development only. Production requires DATABASE_URL.
# PGLITE_PATH=data/west-loop.pg
